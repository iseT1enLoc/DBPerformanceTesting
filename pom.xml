<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot parent manages all Spring dependency versions for us.
        We never have to write <version> for Spring libraries after this.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>db-perform-test</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>DBPerformTest</name>
    <description>Oracle NoSQL SDK performance benchmark + Spring REST API learning</description>

    <properties>
        <java.version>17</java.version>
        <nosqldriver.version>5.4.24</nosqldriver.version>
    </properties>

    <dependencies>
        <!-- Brings in: Spring MVC, Jackson (JSON), embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Oracle NoSQL SDK (for the benchmark Main class) -->
        <dependency>
            <groupId>com.oracle.nosql.sdk</groupId>
            <artifactId>nosqldriver</artifactId>
            <version>${nosqldriver.version}</version>
        </dependency>

        <!-- Guava (used by UserCrudTest) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.2.1-jre</version>
        </dependency>

        <!-- JUnit 5 + Mockito — no Spring context needed for unit tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Spring Boot plugin packages the app as a runnable fat jar.
                mvn package  →  java -jar target/db-perform-test-0.0.1-SNAPSHOT.jar
                The main class is SpringApp (the REST server).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.dbperformtest.api.SpringApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
